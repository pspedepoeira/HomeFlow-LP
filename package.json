{
  "name": "homeflow-landing",
  "version": "1.0.0",
  "description": "Landing page de pré-cadastro do HomeFlow (front-end + back-end)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true
}
