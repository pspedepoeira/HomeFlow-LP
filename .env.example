# Porta HTTP
PORT=3000
# Token do painel /admin e das rotas /api/admin/* (gere com: openssl rand -hex 24)
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
# Caminho do banco SQLite (padrão: ./data/homeflow.db)
# DB_PATH=./data/homeflow.db
# Opcional: URL que recebe cada novo cadastro via POST JSON (RD Station, Zapier, Make, n8n...)
# WEBHOOK_URL=
# Use 1 se rodar atrás de Nginx/Cloudflare/Render, para o rate limit enxergar o IP real
# TRUST_PROXY=1
